{
  "name": "@trajs/extension-anthropic",
  "version": "0.0.0-alpha.0",
  "description": "A recording read as the conversations the Anthropic Messages API takes.",
  "homepage": "https://github.com/OpenInsightDev/trajs",
  "license": "MIT",
  "author": "Bowei Wang <wozluohd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenInsightDev/trajs.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./*": "./src/*.ts",
    "./internal/*": null,
    ".*/index": null
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json",
      "./*": "./dist/*.mjs",
      "./internal/*": null,
      ".*/index": null
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@effect/ai-anthropic": "catalog:",
    "@trajs/core": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
