{
  "$schema": "https://unpkg.com/@changesets/config@4.0.1/schema.json",
  "changelog": ["@changesets/changelog-github", { "repo": "trajs-ai/trajs" }],
  "commit": false,
  "access": "public",
  "baseBranch": "main",
  "updateInternalDependencies": "patch",
  "privatePackages": false,
  "ignore": ["@trajs/cli", "@trajs/extension-*", "@trajs/ui-*"],
  "fixed": [
    [
      "@trajs/core",
      "@trajs/olap",
      "@trajs/platform-browser",
      "@trajs/platform-bun",
      "@trajs/platform-node",
      "@trajs/utils"
    ]
  ]
}
