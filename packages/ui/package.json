{
  "name": "@trajs/ui",
  "version": "0.0.0-alpha.0",
  "description": "The shadcn/ui components the trajs prompt components render with.",
  "homepage": "https://github.com/OpenInsightDev/trajs",
  "license": "MIT",
  "author": "Bowei Wang <wozluohd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenInsightDev/trajs.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#hooks/*": "./src/hooks/*.ts"
  },
  "exports": {
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      "./components/*": "./dist/components/*.mjs",
      "./hooks/*": "./dist/hooks/*.mjs",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@shadcn/react": "catalog:",
    "class-variance-authority": "catalog:",
    "cmdk": "catalog:",
    "cn": "catalog:",
    "lucide-react": "catalog:",
    "next-themes": "catalog:",
    "react-resizable-panels": "catalog:",
    "sonner": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
