{
  "name": "@trajs/olap",
  "version": "0.0.0-alpha.2",
  "description": "Trajectories read as the rows an OLAP store aggregates them in, and the ClickHouse they are asked of.",
  "homepage": "https://github.com/trajs-ai/trajs",
  "license": "MIT",
  "author": "Bowei Wang <wozluohd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trajs-ai/trajs.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./*": "./src/*.ts",
    "./internal/*": null,
    "./*/index": null
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json",
      "./*": "./dist/*.mjs",
      "./internal/*": null,
      "./*/index": null
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@effect/sql-clickhouse": "catalog:",
    "@trajs/core": "workspace:*",
    "chdb": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
