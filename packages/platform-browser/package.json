{
  "name": "@trajs/platform-browser",
  "version": "0.0.0-alpha.5",
  "description": "The browser implementations of the trajs platform services.",
  "homepage": "https://github.com/trajs-ai/trajs",
  "license": "MIT",
  "author": "Bowei Wang <wozluohd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trajs-ai/trajs.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./*": "./src/*.ts",
    "./internal/*": null,
    "./*/index": null
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json",
      "./*": "./dist/*.mjs",
      "./internal/*": null,
      "./*/index": null
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@noble/hashes": "catalog:",
    "@node-rs/xxhash-wasm32-wasi": "catalog:",
    "@structured-world/structured-zstd": "catalog:",
    "@trajs/utils": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
