{
  "name": "@trajs/core",
  "version": "0.0.0-alpha.2",
  "description": "The redesigned core package for trajs.",
  "homepage": "https://github.com/trajs-ai/trajs",
  "license": "MIT",
  "author": "Bowei Wang <wozluohd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trajs-ai/trajs.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./codec": "./src/codec/index.ts",
    "./unstable/atif": "./src/unstable/atif/index.ts",
    "./unstable/Indexing": "./src/unstable/Indexing.ts",
    "./unstable/otel": "./src/unstable/otel/index.ts",
    "./package.json": "./package.json",
    "./*": "./src/*.ts",
    "./internal/*": null,
    "./codec/internal/*": null,
    "./unstable/atif/internal/*": null,
    "./unstable/otel/internal/*": null,
    "./*/index": null
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./codec": "./dist/codec/index.mjs",
      "./unstable/atif": "./dist/unstable/atif/index.mjs",
      "./unstable/Indexing": "./dist/unstable/Indexing.mjs",
      "./unstable/otel": "./dist/unstable/otel/index.mjs",
      "./package.json": "./package.json",
      "./*": "./dist/*.mjs",
      "./internal/*": null,
      "./codec/internal/*": null,
      "./unstable/atif/internal/*": null,
      "./unstable/otel/internal/*": null,
      "./*/index": null
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@effect/ai-anthropic": "catalog:",
    "@effect/ai-openai-compat": "catalog:",
    "@trajs/utils": "workspace:*",
    "effect": "catalog:",
    "uuid": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
